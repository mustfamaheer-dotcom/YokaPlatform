# ══════════════════════════════════════════════════════════
#   Yoka Platform — Production Environment Variables
#   Copy this to Coolify → App → Environment Variables
#   DO NOT commit .env with real values to git!
# ══════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────
NODE_ENV=production

# ─── Database (PostgreSQL 16 via Coolify) ─────────────────
# DB_HOST must match the Coolify service name (internal Docker hostname)
DB_CLIENT=pg
DB_HOST=yoka-postgres
DB_PORT=5432
DB_NAME=yoka_production
DB_USER=yoka_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false

# ─── Redis 7 (via Coolify) ────────────────────────────────
# REDIS_HOST must match the Coolify service name
REDIS_HOST=yoka-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT Secrets (generate with: openssl rand -hex 64) ───
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── App Port ─────────────────────────────────────────────
PORT=3001
PORT_SWM=3001

# ─── Frontend Origins ─────────────────────────────────────
# Set these to your actual domain
CLIENT_ORIGIN=https://yourdomain.com
ECP_ORIGIN=https://yourdomain.com
PUBLIC_STORE_URL=https://yourdomain.com

# ─── Uploads ──────────────────────────────────────────────
UPLOADS_DIR=/app/uploads

# ─── Firebase (Admin SDK) ─────────────────────────────────
# Get from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=yokastore-XXXXX
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@yokastore-XXXXX.iam.gserviceaccount.com
# Paste private key with literal \n (not real newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
