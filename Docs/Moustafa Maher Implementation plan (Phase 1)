// client-swm/src/components/VariantMatrix.jsx
import { useState } from 'react';
import { Checkbox, InputNumber, Table, Tag } from 'antd';

const SIZES = ['XS', 'S', 'M', 'L', 'XL', 'XXL'];
const COLORS = ['Black', 'White', 'Navy', 'Red', 'Green', 'Beige'];

export default function VariantMatrix({ onChange }) {
  const [selectedSizes, setSelectedSizes] = useState(['M', 'L', 'XL']);
  const [selectedColors, setSelectedColors] = useState(['Black', 'White']);

  const variants = selectedColors.flatMap(color =>
    selectedSizes.map(size => ({ color, size, price_modifier: 0 }))
  );

  // Call parent onChange with generated variants
  const handleChange = (updated) => onChange(updated);

  return (
    <div>
      <div style={{ marginBottom: 12 }}>
        <strong>Sizes:</strong>
        <Checkbox.Group options={SIZES} value={selectedSizes} onChange={setSelectedSizes} style={{ marginLeft: 8 }} />
      </div>
      <div style={{ marginBottom: 12 }}>
        <strong>Colors:</strong>
        <Checkbox.Group options={COLORS} value={selectedColors} onChange={setSelectedColors} style={{ marginLeft: 8 }} />
      </div>
      <Table
        size="small"
        dataSource={variants.map((v, i) => ({ ...v, key: i }))}
        columns={[
          { title: 'Color', dataIndex: 'color', render: c => <Tag color="blue">{c}</Tag> },
          { title: 'Size', dataIndex: 'size', render: s => <Tag color="green">{s}</Tag> },
          { title: 'SKU', render: (_, r) => `SKU-${r.color.toUpperCase()}-${r.size}` },
          { title: 'Price Modifier', dataIndex: 'price_modifier',
            render: (v, r) => (
              <InputNumber size="small" defaultValue={0} prefix="+" suffix="EGP"
                onChange={val => { r.price_modifier = val; handleChange(variants); }} />
            )
          }
        ]}
        pagination={false}
      />
    </div>
  );
}
```

