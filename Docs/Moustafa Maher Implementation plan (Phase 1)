```javascript
// server/swm/routes/products.js
const router = require('express').Router();
const { query, transaction } = require('../../shared/db');
const { requireAuth, requireRole } = require('../../shared/authMiddleware');
const { logActivity } = require('../../shared/activityLogger');

// POST /api/swm/products — Create product + variants in single transaction
router.post('/', requireAuth, requireRole(['super_admin', 'admin', 'inventory_manager']), async (req, res) => {
  try {
    const { product_name, product_code, category_id, cost_price, selling_price, variants = [] } = req.body;
    if (!product_name || !product_code || !category_id || !cost_price || !selling_price) {
      return res.status(400).json({ success: false, message: 'Required fields missing' });
    }

    const slug = product_name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');

    const result = await transaction(async (client) => {
      // Insert product
      const [prod] = await client.query(
        `INSERT INTO products (product_code, product_name, slug, category_id, cost_price, selling_price, status)
         VALUES ($1,$2,$3,$4,$5,$6,'active') RETURNING id`,
        [product_code, product_name, `${slug}-${Date.now()}`, category_id, cost_price, selling_price]
      );
      const productId = prod.rows[0].id;

      // Insert variants
      for (const v of variants) {
        const sku = `${product_code}-${v.color || ''}-${v.size || ''}`.toUpperCase();
        await client.query(
          `INSERT INTO product_variants (product_id, variant_sku, color, size, price_modifier, status)
           VALUES ($1,$2,$3,$4,$5,'active')`,
          [productId, sku, v.color, v.size, v.price_modifier || 0]
        );
      }
      return productId;
    });

    logActivity({
      userId: req.user.id, branchId: req.user.branchId,
      actionType: 'CREATE_PRODUCT', entityType: 'products', entityId: result,
      newValue: { product_code, product_name, variants_count: variants.length },
      ipAddress: req.ip, userAgent: req.headers['user-agent']
    });

    return res.status(201).json({ success: true, data: { id: result } });
  } catch (err) {
    return res.status(500).json({ success: false, message: err.message });
  }
});

// GET /api/swm/products — Paginated list with inventory joins
router.get('/', requireAuth, async (req, res) => {
  try {
    const { page = 1, limit = 20, search, category_id, branch_id } = req.query;
    const offset = (page - 1) * limit;

    let sql = `
      SELECT p.id, p.product_code, p.product_name, p.selling_price, p.cost_price,
             p.status, p.is_ecom_listed, p.category_id,
             COALESCE(SUM(ib.available_qty), 0) AS total_stock
      FROM products p
      LEFT JOIN inventory_balances ib ON ib.product_id = p.id
        ${branch_id ? `AND ib.branch_id = $3` : ''}
      WHERE 1=1
        ${search ? `AND (p.product_name ILIKE $1 OR p.product_code ILIKE $1)` : ''}
        ${category_id ? `AND p.category_id = $2` : ''}
      GROUP BY p.id
      ORDER BY p.created_at DESC
      LIMIT ${limit} OFFSET ${offset}
    `;

    const params = [];
    if (search) params.push(`%${search}%`);
    if (category_id) params.push(category_id);
    if (branch_id) params.push(branch_id);

    const products = await query(sql, params);
    return res.json({ success: true, data: products, meta: { page: parseInt(page), limit: parseInt(limit) } });
  } catch (err) {
    return res.status(500).json({ success: false, message: err.message });
  }
});

// PUT /api/swm/products/:id — Update product with price diff logging
router.put('/:id', requireAuth, requireRole(['super_admin', 'admin', 'inventory_manager']), async (req, res) => {
  try {
    const { id } = req.params;
    const [old] = await query(`SELECT * FROM products WHERE id = $1`, [id]);
    if (!old) return res.status(404).json({ success: false, message: 'Product not found' });

    const { product_name, selling_price, cost_price, status, is_ecom_listed } = req.body;

    await query(
      `UPDATE products SET
        product_name = COALESCE($1, product_name),
        selling_price = COALESCE($2, selling_price),
        cost_price = COALESCE($3, cost_price),
        status = COALESCE($4, status),
        is_ecom_listed = COALESCE($5, is_ecom_listed),
        updated_at = NOW()
       WHERE id = $6`,
      [product_name, selling_price, cost_price, status, is_ecom_listed, id]
    );

    logActivity({
      userId: req.user.id, branchId: req.user.branchId,
      actionType: 'UPDATE_PRODUCT',
      entityType: 'products', entityId: id,
      oldValue: { price: old.selling_price, cost: old.cost_price, status: old.status },
      newValue: { price: selling_price, cost: cost_price, status },
      ipAddress: req.ip, userAgent: req.headers['user-agent'],
      notes: `Price changed from ${old.selling_price} to ${selling_price}`
    });

    return res.json({ success: true, message: 'Product updated' });
  } catch (err) {
    return res.status(500).json({ success: false, message: err.message });
  }
});

